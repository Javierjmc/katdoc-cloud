# .env.local — VetCare Pro
# ============================================================
# NUNCA subas este archivo a Git. Está en .gitignore por defecto.
# ============================================================

# ─── Supabase ────────────────────────────────────────────────
# Encuéntralas en: Supabase Dashboard → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://TU_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...

# ─── Autenticación por PIN ──────────────────────────────────
# PIN de 4 dígitos para acceder a la aplicación.
# Cámbialo por el PIN real de tu clínica.

NEXT_PUBLIC_APP_PIN=1234

# ─── Sesión / protección de rutas (S43) ─────────────────────
# APP_PIN: PIN validado en el servidor. Si no se define, se usa NEXT_PUBLIC_APP_PIN.
# AUTH_SECRET: secreto para firmar la cookie de sesión (httpOnly). Si no se
# define, se deriva del PIN (funciona, pero configurarlo es más seguro).
# Genera uno con: openssl rand -hex 32

APP_PIN=1234
AUTH_SECRET=tu_secreto_de_sesion

# ─── IA para exámenes de laboratorio (S9) ───────────────────
# Clave gratuita de Google Gemini (free tier) para extraer analitos de PDFs/fotos.
# Obtenerla en: https://aistudio.google.com/apikey
# (Servidor únicamente; nunca llega al navegador)

GEMINI_API_KEY=tu_clave_gemini

# ─── Email de recordatorios (S15/S16) ───────────────────────
# Clave gratuita de Resend (100 emails/día). Si no se configura,
# el botón de email cae a mailto:.
# RESEND_FROM debe ser un dominio verificado en Resend (por defecto onboarding@resend.dev)

RESEND_API_KEY=re_tu_clave_resend
RESEND_FROM=KATDOC <onboarding@resend.dev>

# ─── Seguridad de API routes (S26) ───────────────────────────
# Secreto para que el cron de Vercel llame a /api/reminders/scan.
# Genera uno con: openssl rand -hex 16
# Debe coincidir con la variable CRON_SECRET en Vercel.

CRON_SECRET=tu_secreto_cron
